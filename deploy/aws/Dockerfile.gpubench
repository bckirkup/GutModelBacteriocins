# GutIBM CUDA GPU cost/benefit benchmark image.

ARG CUDA_VERSION=12.4.1
ARG UBUNTU_VERSION=22.04

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      awscli \
      build-essential \
      ca-certificates \
      cmake \
      libhdf5-mpi-dev \
      libopenmpi-dev \
      openmpi-bin \
      python3 \
      python3-pip \
      software-properties-common \
 && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      g++-13 gcc-13 python3.11 python3.11-venv \
 && rm -rf /var/lib/apt/lists/*

ARG CUDA_ARCHITECTURES=75
ARG GUTIBM_GIT_SHA=unknown

ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /src
COPY CMakeLists.txt ./
COPY cmake ./cmake
COPY src ./src
COPY tests ./tests
COPY examples ./examples
COPY python ./python

RUN CC=gcc-13 CXX=g++-13 cmake -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DGUTIBM_USE_MPI=ON \
      -DGUTIBM_USE_HDF5=ON \
      -DGUTIBM_USE_CUDA=ON \
      -DGUTIBM_GIT_SHA="${GUTIBM_GIT_SHA}" \
      -DCMAKE_CUDA_HOST_COMPILER=g++-13 \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
 && cmake --build build -j"$(nproc)" --target gut_ibm \
 && python3.11 -m venv /opt/venv \
 && pip install --no-cache-dir ./python \
 && groupadd --gid 1000 gutibm \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash gutibm \
 && chown -R gutibm:gutibm /src

USER gutibm
WORKDIR /src
ENTRYPOINT ["/bin/bash"]
